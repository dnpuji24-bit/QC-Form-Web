# Build from repository root with a reviewed package-lock.json in server/qc-photo-access.
FROM node:22-alpine
WORKDIR /app
COPY server/qc-photo-access/package.json server/qc-photo-access/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY server/qc-photo-access/nativeAdminEntry.mjs server/qc-photo-access/nativeAdminRuntime.mjs server/qc-photo-access/nativeAdminHttp.mjs server/qc-photo-access/nativeAdminService.mjs server/qc-photo-access/nativeAdminCore.mjs server/qc-photo-access/qcNativeNameRequest.mjs server/qc-photo-access/qcArchiveCore.mjs server/qc-photo-access/qcHistoricalCorrection.mjs ./
ENV NODE_ENV=production
USER node
EXPOSE 8080
CMD ["node","nativeAdminEntry.mjs"]
