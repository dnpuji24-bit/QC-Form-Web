{
  "name": "qc-form-web",
  "private": true,
  "version": "48.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:uat:quick": "node scripts/run-qc-uat-gates.mjs quick",
    "test:uat:smoke": "node scripts/run-qc-uat-gates.mjs smoke",
    "test:uat:full": "node scripts/run-qc-uat-gates.mjs full",
    "test:uat:ui": "node scripts/run-qc-uat-gates.mjs ui",
    "test:uat:full-ui": "node scripts/run-qc-uat-gates.mjs full-ui",
    "test:uat:carryover": "node scripts/run-qc-uat-gates.mjs carryover",
    "test:uat:photo-stage": "node scripts/run-qc-uat-gates.mjs photo-stage",
    "test:uat:photo-trust": "node scripts/test-qc-uat-unified-photo-trusted-stage.mjs && npm run typecheck",
    "test:uat:photo-compress": "node scripts/run-qc-uat-gates.mjs photo-compress",
    "test:uat:photo-storage": "node scripts/test-qc-uat-unified-private-photo-store.mjs && node scripts/test-qc-uat-unified-photo-trusted-stage.mjs && npm run typecheck",
    "test:uat:photo-commit": "node scripts/run-qc-uat-gates.mjs photo-commit",
    "test:uat:photo-transport": "node scripts/test-qc-uat-unified-photo-transport-contract.mjs && npm run test:uat:photo-commit",
    "test:uat:photo-browser": "node scripts/run-qc-uat-gates.mjs photo-browser",
    "test:uat:photo-correction": "node scripts/run-qc-uat-gates.mjs photo-correction",
    "test:uat:photo-recovery": "node --check server/qc-photo-access/uat-unified-photo-failure-assessment.mjs && node --check server/qc-photo-access/uat-unified-browser-photo-cleanup.mjs && node --check scripts/test-qc-uat-unified-full-qc-ui.mjs && node scripts/test-qc-uat-photo-failure-delta.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "firebase": "latest",
    "html2canvas": "latest",
    "jspdf": "latest",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
