rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEST-ONLY rules. Never deploy these rules to form-qc-unm.
    // Records and users are seeded by emulator Admin context.
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function qc(recordId) {
      return get(/databases/$(database)/documents/qc_records/$(recordId)).data;
    }
    function qcExists(recordId) {
      return exists(/databases/$(database)/documents/qc_records/$(recordId));
    }
    // Permissions come from the same role_access/{role} design used by QC.
    // Owner has permanent full access; all other roles are configured by Owner.
    // Missing permission documents/keys fail closed.
    function roleAccessPath() {
      return /databases/$(database)/documents/role_access/$(profile().role);
    }
    function permission(key) {
      return exists(roleAccessPath())
        && get(roleAccessPath()).data.keys().hasAny(['permissions'])
        && get(roleAccessPath()).data.permissions.keys().hasAny([key])
        ? get(roleAccessPath()).data.permissions[key]
        : 'none';
    }
    function canView(key) {
      return profile().role == 'owner' || permission(key) in ['view', 'edit'];
    }
    function canEdit(key) {
      return profile().role == 'owner' || permission(key) == 'edit';
    }
    function recordOwnedByUser(recordId) {
      return qc(recordId).inputtedBy == profile().username;
    }
    function mandorRole() {
      return profile().role in ['mandor_spraying','mandor_fertilizer'];
    }
    function matchingMandorType(recordId) {
      return (profile().role == 'mandor_spraying' && qc(recordId).formType == 'spray')
        || (profile().role == 'mandor_fertilizer' && qc(recordId).formType == 'fertilizer');
    }
    function allowedRecordScope(recordId) {
      return !mandorRole() || (recordOwnedByUser(recordId) && matchingMandorType(recordId));
    }
    function canReadRecord(recordId) {
      return qcExists(recordId)
        && canView('qc_records')
        && allowedRecordScope(recordId);
    }
    function canCreatePhoto(recordId) {
      return qcExists(recordId)
        && canEdit(qc(recordId).formType == 'spray' ? 'qc_spraying' : 'qc_fertilizer')
        && allowedRecordScope(recordId)
        && recordOwnedByUser(recordId)
        && qc(recordId).ownerUid == request.auth.uid;
    }
    function photoShape(recordId, photoId) {
      let d = request.resource.data;
      return d.keys().hasAll(['photoId', 'qcRecordId', 'ownerUid', 'recordRevision',
        'provider', 'bucket', 'objectPath', 'kind', 'contentType', 'uploadedAt'])
        && d.keys().hasOnly(['photoId', 'qcRecordId', 'ownerUid', 'recordRevision',
          'provider', 'bucket', 'objectPath', 'kind', 'contentType', 'uploadedAt', 'holdId'])
        && d.photoId == photoId
        && d.qcRecordId == recordId
        && d.ownerUid == request.auth.uid
        && d.provider == 'supabase'
        && d.bucket == 'qc-photos-test'
        && d.recordRevision is string && d.recordRevision.size() > 0 && d.recordRevision.size() <= 160
        && d.uploadedAt is string && d.uploadedAt.size() <= 40
        && d.kind in ['main','hold','scan']
        && d.contentType in ['image/jpeg','image/png','image/webp']
        && photoId.matches('^[A-Za-z0-9_-]{1,160}$')
        && recordId.matches('^[A-Za-z0-9_-]{1,160}$')
        && d.objectPath is string
        && d.objectPath.matches('^' + request.auth.uid + '/qc/' + recordId + '/[A-Za-z0-9_-]+\\.(jpg|png|webp)$')
        && (d.kind == 'hold'
            ? (d.keys().hasAll(['holdId']) && d.holdId is string
              && d.holdId.matches('^[A-Za-z0-9_-]{1,160}$'))
            : !d.keys().hasAny(['holdId']));
    }
    match /qc_photo_metadata/{recordId}/photos/{photoId} {
      // Single-document read can inspect the stored metadata.
      allow get: if active() && canReadRecord(recordId)
        && resource.data.qcRecordId == recordId
        && resource.data.ownerUid == qc(recordId).ownerUid;
      // Collection listing cannot inspect resource.data per document. Restrict
      // by parent QC record access and list limit instead.
      allow list: if active() && canReadRecord(recordId)
        && request.query.limit != null && request.query.limit <= 100;
      // Only uploader writes a reference to their OWN QC. Other roles require
      // an audited backend handoff for photos of someone else's QC.
      allow create: if active() && qcExists(recordId)
        && canCreatePhoto(recordId)
        && qc(recordId).clientRevision == request.resource.data.recordRevision
        && photoShape(recordId, photoId);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
